{
  "name": "nearx",
  "version": "0.4.0",
  "private": true,
  "description": "NEARx - NEAR Blockchain Explorer (Web E2E Tests)",
  "workspaces": [
    "web",
    "e2e-tests"
  ],
  "scripts": {
    "build:sidecar": "node tools/build-sidecar.mjs",
    "build:macos-qa": "tools/build-macos-qa.sh",
    "e2e:install": "npx playwright install --with-deps",
    "e2e": "playwright test",
    "e2e:web": "NEARX_BASE_URL=http://127.0.0.1:8083 playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "PWDEBUG=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.2"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=20 <21"
  }
}
